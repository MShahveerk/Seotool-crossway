generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                   @id @default(cuid()) @db.VarChar(191)
  email                String                   @unique @db.VarChar(191)
  password             String                   @map("password_hash") @db.Text
  name                 String?                  @db.VarChar(255)
  role                 String                   @default("user") @db.VarChar(50)
  /// Granular module access: { gsc: string[], seo: string[], social: string[], blogs: string[] }
  modulePermissions    Json?                    @map("module_permissions")
  /// Staff weekly digest (site-scoped website + SMM internal decks)
  weeklyDigestEnabled  Boolean                  @default(false) @map("weekly_digest_enabled")
  /// Client-facing report preferences (any role may enable)
  receiveWebsiteReport Boolean                  @default(false) @map("receive_website_report")
  receiveSmmReport     Boolean                  @default(false) @map("receive_smm_report")
  receiveCombinedReport Boolean                 @default(false) @map("receive_combined_report")
  siteLink             String?                  @map("site_link") @db.VarChar(512)
  gtmContainerId       String?                  @map("gtm_container_id") @db.VarChar(64)
  facebookPageId       String?                  @map("facebook_page_id") @db.VarChar(191)
  instagramUserId      String?                  @map("instagram_user_id") @db.VarChar(191)
  isActive             Boolean                  @default(false) @map("is_active")
  emailVerified        Boolean                  @default(false) @map("email_verified")
  status               String                   @default("pending") @db.VarChar(50)
  emailVerifiedAt      DateTime?                @map("email_verified_at")
  createdBy            String?                  @map("created_by") @db.VarChar(191)
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")
  deletedAt            DateTime?                @map("deleted_at")
  createdByUser        User?                    @relation("UserCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdUsers         User[]                   @relation("UserCreatedBy")
  accessibleSites      UserAccessibleSite[]
  verificationLogs     VerificationLog[]
  smmDailyStats        SocialMediaDailyStat[]
  approvalsReceived  Approval[]             @relation("ApprovalAssignee")
  approvalsCreated   Approval[]             @relation("ApprovalCreatedBy")
  blogsReceived      BlogPost[]             @relation("BlogAssignee")
  blogsCreated       BlogPost[]             @relation("BlogCreatedBy")
  blogRevisions      BlogPostRevision[]     @relation("BlogRevisionActor")
  blogStudioRuns     BlogAutomationRun[]    @relation("BlogStudioRunTriggeredBy")
  postStudioRuns     PostAutomationRun[]    @relation("PostStudioRunTriggeredBy")
  seoAutopilotRuns   SeoAutopilotRun[]      @relation("SeoAutopilotRunTriggeredBy")

  @@index([role])
  @@index([isActive], map: "users_is_active_idx")
  @@index([createdBy], map: "users_created_by_idx")
  @@index([siteLink], map: "users_site_link_idx")
  @@index([gtmContainerId], map: "users_gtm_container_id_idx")
  @@index([facebookPageId], map: "users_facebook_page_id_idx")
  @@index([instagramUserId], map: "users_instagram_user_id_idx")
  @@index([status, emailVerified, createdAt], map: "users_status_verification_created_idx")
  @@map("users")
}

model Approval {
  id                    String    @id @default(cuid()) @db.VarChar(191)
  title                 String    @db.VarChar(255)
  /// Assignee-visible heading when set (trimmed); otherwise `title` from admin is shown.
  userEditedTitle       String?   @map("user_edited_title") @db.VarChar(255)
  /// Optional post caption set by admin; assignee may edit into userEditedCaption.
  caption               String    @default("") @db.VarChar(2000)
  bodyText              String    @map("body_text") @db.Text
  imagePath             String    @map("image_path") @db.VarChar(512)
  /// Up to 3 alternate creatives; assignee/admin can promote one before approval.
  backupImagePaths      Json?     @map("backup_image_paths")
  assigneeId            String    @map("assignee_id") @db.VarChar(191)
  createdById           String    @map("created_by_id") @db.VarChar(191)
  status                String    @default("pending") @db.VarChar(32)
  userEditedText        String?   @map("user_edited_text") @db.Text
  userEditedCaption     String?   @map("user_edited_caption") @db.Text
  /// Legacy DB column; kept empty for new rows. Assignee text is stored in `userEditedInstructions`.
  instructions           String    @default("") @db.VarChar(5000)
  /// Posting instructions / suggestions written by the assignee (not shown on admin create form).
  userEditedInstructions String?   @map("user_edited_instructions") @db.Text
  respondedAt           DateTime? @map("responded_at")
  lastAction            String?   @map("last_action") @db.VarChar(32)
  awaitingAdminReview   Boolean   @default(false) @map("awaiting_admin_review")
  /// When true, assignee dashboards and SMM approval cards hide this item (Super Admin still sees it here).
  hiddenFromAssignee    Boolean   @default(false) @map("hidden_from_assignee")
  /// Set when Super Admin chose "approve on assignment" — no assignee review step.
  skippedAssigneeReview Boolean   @default(false) @map("skipped_assignee_review")

  scheduledFor          DateTime? @map("scheduled_for")
  publishStatus         String?   @default("unpublish") @db.VarChar(32) @map("publish_status")
  publishError          String?   @db.Text @map("publish_error")
  facebookPageId        String?   @map("facebook_page_id") @db.VarChar(191)
  instagramUserId       String?   @map("instagram_user_id") @db.VarChar(191)
  siteLink              String?   @map("site_link") @db.VarChar(512)
  /// manual | inbound | meta_pull
  source                String    @default("manual") @db.VarChar(32)
  externalId            String?   @map("external_id") @db.VarChar(191)

  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  assignee  User @relation("ApprovalAssignee", fields: [assigneeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdBy User @relation("ApprovalCreatedBy", fields: [createdById], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([assigneeId], map: "approvals_assignee_id_idx")
  @@index([facebookPageId, externalId], map: "approvals_fb_external_idx")
  @@index([siteLink, externalId], map: "approvals_site_external_idx")
  @@index([createdById], map: "approvals_created_by_id_idx")
  @@index([status], map: "approvals_status_idx")
  @@index([awaitingAdminReview], map: "approvals_awaiting_admin_idx")
  @@index([hiddenFromAssignee], map: "approvals_hidden_from_assignee_idx")
  @@map("approvals")
}

model UserAccessibleSite {
  id        String   @id @default(cuid()) @db.VarChar(191)
  userId    String   @map("user_id") @db.VarChar(191)
  siteLink  String   @map("site_link") @db.VarChar(512)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, siteLink], map: "user_site_unique")
  @@index([siteLink], map: "user_accessible_sites_site_link_idx")
  @@map("user_accessible_sites")
}

model PasswordResetToken {
  id        String    @id @default(cuid()) @db.VarChar(191)
  email     String    @db.VarChar(191)
  token     String    @unique @db.VarChar(191)
  expiresAt DateTime  @map("expires_at")
  used      Boolean   @default(false)
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([email], map: "password_reset_tokens_email_idx")
  @@index([expiresAt], map: "password_reset_tokens_expires_at_idx")
  @@index([used], map: "password_reset_tokens_used_idx")
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id          String    @id @default(cuid()) @db.VarChar(191)
  email       String    @db.VarChar(191)
  token       String    @unique @db.VarChar(191)
  expiresAt   DateTime  @map("expires_at")
  used        Boolean   @default(false)
  usedAt      DateTime? @map("used_at")
  invalidatedAt DateTime? @map("invalidated_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([email], map: "email_verification_tokens_email_idx")
  @@index([expiresAt], map: "email_verification_tokens_expires_at_idx")
  @@index([used], map: "email_verification_tokens_used_idx")
  @@map("email_verification_tokens")
}

model VerificationLog {
  id         String    @id @default(cuid()) @db.VarChar(191)
  token      String?   @db.VarChar(255)
  email      String    @db.VarChar(191)
  userId     String?   @map("user_id") @db.VarChar(191)
  success    Boolean
  reason     String?   @db.VarChar(100)
  ip         String?   @db.VarChar(255)
  attemptedAt DateTime @default(now()) @map("attempted_at")
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([email], map: "verification_logs_email_idx")
  @@index([attemptedAt], map: "verification_logs_attempted_at_idx")
  @@map("verification_logs")
}

model SocialMediaDailyStat {
  id           String   @id @default(cuid()) @db.VarChar(191)
  userId       String   @map("user_id") @db.VarChar(191)
  siteLink     String   @map("site_link") @db.VarChar(512)
  platform     String   @db.VarChar(50)
  accountName  String?  @map("account_name") @db.VarChar(191)
  accountHandle String? @map("account_handle") @db.VarChar(191)
  statDate     DateTime @map("stat_date") @db.Date
  followers    Int      @default(0)
  reach        Int      @default(0)
  engagements  Int      @default(0)
  queuedPosts  Int      @default(0) @map("queued_posts")
  queuedReels  Int      @default(0) @map("queued_reels")
  source       String?  @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, siteLink, platform, statDate], map: "smm_user_site_platform_date_unique")
  @@index([siteLink, statDate], map: "smm_site_date_idx")
  @@index([platform, statDate], map: "smm_platform_date_idx")
  @@map("social_media_daily_stats")
}

model Site {
  id              String   @id @default(cuid()) @db.VarChar(191)
  siteUrl         String   @unique @map("site_url") @db.VarChar(512)
  gtmContainerId  String?  @map("gtm_container_id") @db.VarChar(64)
  facebookPageId  String?  @map("facebook_page_id") @db.VarChar(191)
  instagramUserId String?  @map("instagram_user_id") @db.VarChar(191)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([gtmContainerId], map: "sites_gtm_container_id_idx")
  @@index([facebookPageId], map: "sites_facebook_page_id_idx")
  @@index([instagramUserId], map: "sites_instagram_user_id_idx")
  @@map("sites")
}

/// Key/value app config (e.g. seo_digest_enabled).
model AppSetting {
  key       String   @id @db.VarChar(191)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

/// Extra emails that receive the weekly SEO opportunities digest.
model SeoDigestRecipient {
  id        String   @id @default(cuid()) @db.VarChar(191)
  email     String   @unique @db.VarChar(191)
  label     String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("seo_digest_recipients")
}

/// One daily URL-inspection run for a site property.
model UrlInspectionSnapshot {
  id             String                @id @default(cuid()) @db.VarChar(191)
  siteUrl        String                @map("site_url") @db.VarChar(512)
  runDate        DateTime              @map("run_date") @db.Date
  status         String                @default("running") @db.VarChar(32)
  totalUrls      Int                   @default(0) @map("total_urls")
  indexedCount   Int                   @default(0) @map("indexed_count")
  notIndexedCount Int                  @default(0) @map("not_indexed_count")
  unknownCount   Int                   @default(0) @map("unknown_count")
  errorCount     Int                   @default(0) @map("error_count")
  startedAt      DateTime              @default(now()) @map("started_at")
  finishedAt     DateTime?             @map("finished_at")
  errorMessage   String?               @map("error_message") @db.Text
  results        UrlInspectionResult[]

  @@unique([siteUrl, runDate], map: "url_inspection_snapshot_site_date_unique")
  @@index([siteUrl, runDate], map: "url_inspection_snapshot_site_date_idx")
  @@map("url_inspection_snapshots")
}

/// Per-URL inspection result within a daily snapshot.
model UrlInspectionResult {
  id                 String               @id @default(cuid()) @db.VarChar(191)
  snapshotId         String               @map("snapshot_id") @db.VarChar(191)
  inspectionUrl      String               @map("inspection_url") @db.VarChar(2048)
  category           String               @default("unknown") @db.VarChar(32)
  verdict            String?              @db.VarChar(64)
  coverageState      String?              @map("coverage_state") @db.VarChar(255)
  indexingState      String?              @map("indexing_state") @db.VarChar(255)
  robotsTxtState     String?              @map("robots_txt_state") @db.VarChar(128)
  pageFetchState     String?              @map("page_fetch_state") @db.VarChar(128)
  lastCrawlTime      DateTime?            @map("last_crawl_time")
  googleCanonical    String?              @map("google_canonical") @db.VarChar(2048)
  userCanonical      String?              @map("user_canonical") @db.VarChar(2048)
  cause              String?              @db.Text
  errorMessage       String?              @map("error_message") @db.Text
  createdAt          DateTime             @default(now()) @map("created_at")
  snapshot           UrlInspectionSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([snapshotId, category], map: "url_inspection_result_snapshot_cat_idx")
  @@index([inspectionUrl], map: "url_inspection_result_url_idx")
  @@map("url_inspection_results")
}

/// Actionable indexing fix tasks auto-created from not-indexed URL inspections.
model SeoIndexingTask {
  id               String    @id @default(cuid()) @db.VarChar(191)
  siteUrl          String    @map("site_url") @db.VarChar(512)
  pageUrl          String    @map("page_url") @db.VarChar(2048)
  title            String    @db.VarChar(512)
  issueType        String    @map("issue_type") @db.VarChar(64)
  cause            String?   @db.Text
  coverageState    String?   @map("coverage_state") @db.VarChar(255)
  verdict          String?   @db.VarChar(64)
  summary          String?   @db.Text
  /// Array of { title, detail } step objects
  steps            Json
  status           String    @default("open") @db.VarChar(32)
  sourceSnapshotId String?   @map("source_snapshot_id") @db.VarChar(191)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  completedAt      DateTime? @map("completed_at")

  @@unique([siteUrl, pageUrl], map: "seo_indexing_task_site_page_unique")
  @@index([siteUrl, status], map: "seo_indexing_task_site_status_idx")
  @@index([issueType], map: "seo_indexing_task_issue_idx")
  @@map("seo_indexing_tasks")
}

/// Audit log for client/approver report emails and exports.
model ClientReportSendLog {
  id             String   @id @default(cuid()) @db.VarChar(191)
  siteKey        String   @map("site_key") @db.VarChar(512)
  recipientEmail String   @map("recipient_email") @db.VarChar(191)
  reportTypes    Json     @map("report_types")
  trigger        String   @default("manual") @db.VarChar(32)
  status         String   @default("sent") @db.VarChar(32)
  errorMessage   String?  @map("error_message") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([siteKey, createdAt], map: "client_report_send_site_created_idx")
  @@index([recipientEmail], map: "client_report_send_recipient_idx")
  @@map("client_report_send_logs")
}

/// Blog content awaiting approval and scheduled publishing (WordPress-shaped payload).
model BlogPost {
  id                    String    @id @default(cuid()) @db.VarChar(191)
  siteLink              String    @map("site_link") @db.VarChar(512)
  assigneeId            String    @map("assignee_id") @db.VarChar(191)
  createdById           String    @map("created_by_id") @db.VarChar(191)
  status                String    @default("pending") @db.VarChar(32)
  source                String    @default("manual") @db.VarChar(32)
  externalId            String?   @map("external_id") @db.VarChar(191)
  title                 String    @db.VarChar(512)
  slug                  String?   @db.VarChar(255)
  excerpt               String?   @db.Text
  content               String    @db.Text
  wpStatus              String    @default("draft") @map("wp_status") @db.VarChar(32)
  featuredImagePath     String?   @map("featured_image_path") @db.VarChar(512)
  featuredImageAlt      String?   @map("featured_image_alt") @db.VarChar(512)
  /// Up to 3 alternate featured images; switchable before approval.
  backupImagePaths      Json?     @map("backup_image_paths")
  payload               Json
  userEditedTitle       String?   @map("user_edited_title") @db.VarChar(512)
  userEditedSlug        String?   @map("user_edited_slug") @db.VarChar(255)
  userEditedExcerpt     String?   @map("user_edited_excerpt") @db.Text
  userEditedContent     String?   @map("user_edited_content") @db.Text
  scheduledFor          DateTime? @map("scheduled_for")
  publishStatus         String?   @default("unpublish") @map("publish_status") @db.VarChar(32)
  publishError          String?   @map("publish_error") @db.Text
  externalPostId        String?   @map("external_post_id") @db.VarChar(191)
  respondedAt           DateTime? @map("responded_at")
  approvalNotifiedAt    DateTime? @map("approval_notified_at")
  lastAction            String?   @map("last_action") @db.VarChar(32)
  awaitingAdminReview   Boolean   @default(false) @map("awaiting_admin_review")
  hiddenFromAssignee    Boolean   @default(false) @map("hidden_from_assignee")
  skippedAssigneeReview Boolean   @default(false) @map("skipped_assignee_review")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  assignee     User             @relation("BlogAssignee", fields: [assigneeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdBy    User             @relation("BlogCreatedBy", fields: [createdById], references: [id], onDelete: Cascade, onUpdate: Cascade)
  publishLogs  BlogPublishLog[]
  revisions    BlogPostRevision[]

  @@unique([siteLink, externalId], map: "blog_post_site_external_unique")
  @@index([assigneeId], map: "blog_posts_assignee_id_idx")
  @@index([siteLink], map: "blog_posts_site_link_idx")
  @@index([status], map: "blog_posts_status_idx")
  @@index([scheduledFor], map: "blog_posts_scheduled_for_idx")
  @@index([publishStatus], map: "blog_posts_publish_status_idx")
  @@map("blog_posts")
}

/// Per-site blog delivery settings (webhook, API, WordPress, email fallback chain).
model SitePublishConfig {
  id                   String   @id @default(cuid()) @db.VarChar(191)
  siteLink             String   @unique @map("site_link") @db.VarChar(512)
  enabled              Boolean  @default(true)
  inboundSecret        String?  @map("inbound_secret") @db.VarChar(191)
  deliveryChain        Json     @default("[\"webhook\",\"wordpress\",\"api\",\"email\"]") @map("delivery_chain")
  webhookUrl           String?  @map("webhook_url") @db.VarChar(2048)
  webhookSecret        String?  @map("webhook_secret") @db.VarChar(512)
  apiUrl               String?  @map("api_url") @db.VarChar(2048)
  apiKey               String?  @map("api_key") @db.VarChar(512)
  apiHeaders           Json?    @map("api_headers")
  wordpressUrl         String?  @map("wordpress_url") @db.VarChar(2048)
  wordpressUsername    String?  @map("wordpress_username") @db.VarChar(191)
  wordpressAppPassword String?  @map("wordpress_app_password") @db.VarChar(512)
  emailRecipients      String?  @map("email_recipients") @db.Text
  defaultCategories    Json?    @map("default_categories")
  defaultTags          Json?    @map("default_tags")
  wordpressPullEnabled Boolean  @default(false) @map("wordpress_pull_enabled")
  wordpressPullStatuses Json?   @default("[\"draft\",\"future\"]") @map("wordpress_pull_statuses")
  lastWordpressPullAt  DateTime? @map("last_wordpress_pull_at")
  emailInboundEnabled  Boolean  @default(false) @map("email_inbound_enabled")
  imapHost             String?  @map("imap_host") @db.VarChar(255)
  imapPort             Int      @default(993) @map("imap_port")
  imapUser             String?  @map("imap_user") @db.VarChar(255)
  imapPassword         String?  @map("imap_password") @db.Text
  imapFolder           String   @default("INBOX") @map("imap_folder") @db.VarChar(128)
  lastEmailPullAt      DateTime? @map("last_email_pull_at")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("site_publish_configs")
}

/// Per Meta page / client account: SMM post ingestion and publish settings.
model SitePostConfig {
  id                  String   @id @default(cuid()) @db.VarChar(191)
  /// Meta page ID or website URL (matches dashboard client selector).
  siteKey             String   @unique @map("site_key") @db.VarChar(512)
  enabled             Boolean  @default(true)
  inboundSecret       String?  @map("inbound_secret") @db.VarChar(191)
  /// Optional per-page Meta token for publish (and future draft pull). Falls back to env.
  metaPageAccessToken String?  @map("meta_page_access_token") @db.Text
  metaPullEnabled     Boolean  @default(false) @map("meta_pull_enabled")
  facebookPageId      String?  @map("facebook_page_id") @db.VarChar(191)
  /// Graph page name, kept so Meta projects survive when live lookup is empty.
  pageName            String?  @map("page_name") @db.VarChar(255)
  instagramUserId     String?  @map("instagram_user_id") @db.VarChar(191)
  lastMetaPullAt      DateTime? @map("last_meta_pull_at")
  emailInboundEnabled Boolean  @default(false) @map("email_inbound_enabled")
  imapHost            String?  @map("imap_host") @db.VarChar(255)
  imapPort            Int      @default(993) @map("imap_port")
  imapUser            String?  @map("imap_user") @db.VarChar(255)
  imapPassword        String?  @map("imap_password") @db.Text
  imapFolder          String   @default("INBOX") @map("imap_folder") @db.VarChar(128)
  lastEmailPullAt     DateTime? @map("last_email_pull_at")
  deliveryChain       Json     @default("[\"meta\",\"webhook\",\"api\",\"email\"]") @map("delivery_chain")
  webhookUrl          String?  @map("webhook_url") @db.VarChar(2048)
  webhookSecret       String?  @map("webhook_secret") @db.VarChar(512)
  apiUrl              String?  @map("api_url") @db.VarChar(2048)
  apiKey              String?  @map("api_key") @db.VarChar(512)
  apiHeaders          Json?    @map("api_headers")
  emailRecipients     String?  @map("email_recipients") @db.Text
  publishToFacebook   Boolean  @default(true) @map("publish_to_facebook")
  publishToInstagram  Boolean  @default(true) @map("publish_to_instagram")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([facebookPageId], map: "site_post_configs_fb_idx")
  @@map("site_post_configs")
}

/// Audit trail for blog publish attempts.
model BlogPublishLog {
  id           String   @id @default(cuid()) @db.VarChar(191)
  blogPostId   String   @map("blog_post_id") @db.VarChar(191)
  method       String   @db.VarChar(32)
  success      Boolean  @default(false)
  externalId   String?  @map("external_id") @db.VarChar(191)
  responseBody String?  @map("response_body") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  blogPost BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([blogPostId, createdAt], map: "blog_publish_logs_post_created_idx")
  @@map("blog_publish_logs")
}

/// Cached PageSpeed Insights run per site + strategy, refreshed by cron every 2 hours.
model PageSpeedSnapshot {
  id           String    @id @default(cuid()) @db.VarChar(191)
