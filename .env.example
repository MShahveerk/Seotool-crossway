# Copy to .env.local and fill in values. Never commit real secrets.
#
# Prisma CLI only loads `.env` by default. This repo’s npm scripts run Prisma via
# `scripts/prisma-with-local-env.mjs`, which loads `.env` then `.env.local`, so
# `DATABASE_URL` in `.env.local` works for: npm run prisma:deploy, prisma:push, etc.

# --- Core (required in production) ---
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32-min-32-chars"

# --- Google (Search Console / PageSpeed) ---
# Path to service account JSON file (repo-relative) OR inline JSON string for serverless:
GOOGLE_APPLICATION_CREDENTIALS_JSON="./credentials/your-service-account.json"
PAGESPEED_API_KEY=""

# --- Email (password reset, verification) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# --- SMM / GTM ingestion ---
# Required in production for POST /api/smm/collect (GTM webhook)
SMM_COLLECT_SECRET=""

# --- Blog publishing (additive) ---
# Global inbound secret for POST /api/blogs/inbound (per-site secret can override in UI)
BLOG_INBOUND_SECRET=""
# Fallback email recipients when delivery chain reaches email step
BLOG_PUBLISH_EMAIL=""

# --- Optional: auto-fetch social metrics (Super Admin) ---
YOUTUBE_API_KEY=""
META_APP_ACCESS_TOKEN=""
META_PAGE_ACCESS_TOKEN=""
META_APP_ID=""
META_APP_SECRET=""
# TikTok — https://developers.tiktok.com/ → Manage apps → create app → Credentials (Client key + secret).
# Enable product "Research API" on the app and apply for access (scope research.data.basic) for @username follower lookup.
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# --- SEO automation (in-app cron, Mondays 06:00 server time) ---
# Resubmit every sitemap already listed in GSC for known Sites (opt-in):
# SEO_AUTO_SUBMIT_SITEMAPS=true
# Weekly digest can also be toggled in User Management → Weekly SEO Digest.
# SEO_DIGEST_EMAIL=true is only a fallback if the UI toggle was never set.
# Recipients managed in the UI override SEO_DIGEST_RECIPIENTS / super_admin emails:
# SEO_DIGEST_RECIPIENTS="you@agency.com,seo@agency.com"
#
# Note: sitemap submit needs the Search Console service account as Owner/Full
# on each property (write scope is used automatically by the app).

# Daily URL Inspection monitor (05:00 server time) — sitemap + top pages, capped/rotated:
# SEO_URL_INSPECT_DAILY=true
# SEO_URL_INSPECT_DAILY_LIMIT=200
# (Google hard cap ~2000 inspections/day/property; default 200 is safer for multi-site)

# --- Ops ---
# LOG_LEVEL=INFO
# DOCKER_BUILD=1
# (set DOCKER_BUILD=1 only when building a Docker image that expects output: standalone)
