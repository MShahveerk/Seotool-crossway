# Copy to .env.local and fill in values. Never commit real secrets.
#
# Prisma CLI only loads `.env` by default. This repo’s npm scripts run Prisma via
# `scripts/prisma-with-local-env.mjs`, which loads `.env` then `.env.local`, so
# `DATABASE_URL` in `.env.local` works for: npm run prisma:deploy, prisma:push, etc.

# --- Core (required in production) ---
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32-min-32-chars"

# --- Google (Search Console / PageSpeed) ---
# Path to service account JSON file (repo-relative) OR inline JSON string for serverless:
GOOGLE_APPLICATION_CREDENTIALS_JSON="./credentials/your-service-account.json"
PAGESPEED_API_KEY=""

# --- Google Ads Keyword Planner (same service account as GSC — add SA email to Ads MCC as Admin) ---
# 1) Enable "Google Ads API" in Google Cloud (same project as the service account)
# 2) Add the service account email as Admin on your Ads test/production MCC
# Developer token: https://ads.google.com/aw/apicenter (Basic access for production accounts)
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_CUSTOMER_ID=""
# Required when calling through a manager account (MCC ID, no dashes):
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=""
# Optional: Workspace domain impersonation only (not for @gmail.com Ads accounts)
# GOOGLE_ADS_IMPERSONATE_EMAIL=""
# GOOGLE_ADS_API_VERSION=v24

# --- Site Audit, Site Explorer & Link Index ---
# Open PageRank API key (Keywords Everywhere) — Bearer token starting with opr_live_
# OPTIONAL for Site Explorer / Link Index authority + referring-domain counts (Common Crawl needs no key).
# Create one on the Open PageRank dashboard after signing in with Keywords Everywhere:
# https://openpagerank.keywordseverywhere.com
OPENPAGERANK_API_KEY=""
# After deploying Site Explorer, run once on the server: npm run prisma:deploy
# Max pages crawled per site audit (default 150, hard cap 1000):
# SITE_AUDIT_PAGE_LIMIT=150

# --- Email (password reset, verification) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# --- SMM / GTM ingestion ---
# Required in production for POST /api/smm/collect (GTM webhook)
SMM_COLLECT_SECRET=""

# --- Blog publishing (additive) ---
# Global inbound secret for POST /api/blogs/inbound (per-site secret can override in UI)
BLOG_INBOUND_SECRET=""
# Global inbound secret for POST /api/posts/inbound (per Meta page / site secret can override in Create Post settings)
POST_INBOUND_SECRET=""
# Fallback email recipients when post delivery chain reaches email step
POST_PUBLISH_EMAIL=""
# Fallback email recipients when delivery chain reaches email step
BLOG_PUBLISH_EMAIL=""

# --- OpenRouter (content humanize button, blog automation prompt generator) ---
OPENROUTER_API_KEY=""
# Verified free models (live OpenRouter API, Jul 2026) — append :free or use openrouter/free router:
# OPENROUTER_MODEL_BLOG="google/gemma-4-31b-it:free"
# OPENROUTER_MODEL_CAPTION="inclusionai/ling-3.0-flash:free"
# OPENROUTER_MODEL_PROMPT="google/gemma-4-31b-it:free"
# Or let OpenRouter pick any free model automatically:
# OPENROUTER_MODEL_BLOG="openrouter/free"
# OPENROUTER_MODEL_CAPTION="openrouter/free"
# OPENROUTER_MODEL_PROMPT="openrouter/free"
# Paid defaults if unset (very cheap, not free):
# OPENROUTER_MODEL_BLOG="anthropic/claude-sonnet-5"
# OPENROUTER_MODEL_CAPTION="google/gemini-3.1-flash-lite"
# OPENROUTER_SITE_URL=""
# OPENROUTER_APP_NAME="Crossway SEO Tool"

# --- AI Keyword Research (OpenRouter, OpenAI, or Anthropic — pick one via AI_KEYWORD_PROVIDER) ---
# AI_KEYWORD_PROVIDER="auto"
# auto = first available key: openrouter → anthropic → openai
# AI_KEYWORD_PROVIDER="openrouter"
# AI_KEYWORD_PROVIDER="openai"
# AI_KEYWORD_PROVIDER="anthropic"
# Dedicated model (optional). If unset, falls back to OPENROUTER_MODEL_PROMPT → BLOG → CAPTION → openrouter/free
# OPENROUTER_MODEL_KEYWORD="openrouter/free"
# OPENROUTER_MODEL_KEYWORD="google/gemma-4-31b-it:free"
# OPENAI_API_KEY=""
# OPENAI_MODEL_KEYWORD="gpt-4o-mini"
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL_KEYWORD="claude-sonnet-4-20250514"

# --- Optional: auto-fetch social metrics (Super Admin) ---
YOUTUBE_API_KEY=""
META_APP_ACCESS_TOKEN=""
META_PAGE_ACCESS_TOKEN=""
META_APP_ID=""
META_APP_SECRET=""
# TikTok — https://developers.tiktok.com/ → Manage apps → create app → Credentials (Client key + secret).
# Enable product "Research API" on the app and apply for access (scope research.data.basic) for @username follower lookup.
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# --- Live SEO data API (Domain, Backlinks, Keywords, Audit) ---
# API bearer token for live SEO metrics provider
SERANKING_API_KEY=""
# Hard monthly cap enforced in-app (default 20000):
# SERANKING_MONTHLY_CREDIT_BUDGET=20000
# Max credits per nightly cron run (default 600 ≈ 18k/month):
# SERANKING_DAILY_CREDIT_CAP=600
# Credits reserved for manual/on-demand lookups (default 1500):
# SERANKING_MANUAL_RESERVE=1500
# Pages crawled per site audit (2 credits/page, default 20):
# SERANKING_AUDIT_MAX_PAGES=20

# --- SEO automation (in-app cron, Mondays 06:00 server time) ---
# Daily 04:30 Open PageRank authority · Mondays 05:00 Common Crawl site explorer · Mondays 05:30 live site explorer (7-day cache)
# Optional weekly credit cap for live site explorer cron (default 2400 ≈ 8 domains):
# SERANKING_EXPLORER_WEEKLY_CREDIT_CAP=2400
# Daily 04:45 live SEO snapshot refresh (backlinks, domain, keywords, audit rotation)
# Resubmit every sitemap already listed in GSC for known Sites (opt-in):
# SEO_AUTO_SUBMIT_SITEMAPS=true
# Weekly digest can also be toggled in User Management → Weekly SEO Digest.
# SEO_DIGEST_EMAIL=true is only a fallback if the UI toggle was never set.
# Recipients managed in the UI override SEO_DIGEST_RECIPIENTS / super_admin emails:
# SEO_DIGEST_RECIPIENTS="you@agency.com,seo@agency.com"
#
# Note: sitemap submit needs the Search Console service account as Owner/Full
# on each property (write scope is used automatically by the app).

# Daily URL Inspection monitor (05:00 server time) — sitemap + top pages, capped/rotated:
# SEO_URL_INSPECT_DAILY=true
# SEO_URL_INSPECT_DAILY_LIMIT=200
# (Google hard cap ~2000 inspections/day/property; default 200 is safer for multi-site)

# --- Timezone (must match WordPress Settings → General → Timezone) ---
# Used for schedule display, datetime-local editors, emails, and WP date/date_gmt writes.
# NEXT_PUBLIC_ so the browser UI uses the same zone as the server (default: Asia/Karachi).
# NEXT_PUBLIC_APP_TIMEZONE="Asia/Karachi"
# APP_TIMEZONE="Asia/Karachi"

# --- Persistent media disk (posts + blog images) ---
# Production MUST use a volume outside the deploy directory or images wipe on every release.
# Default when NODE_ENV=production (or when the path exists): /var/data
# Layout:
#   /var/data/uploads/approvals   ← SMM post creatives
#   /var/data/uploads/blogs       ← blog featured images
# Mount your bought disk at /var/data, or override:
# UPLOADS_ROOT="/var/data"
# CROSSWAY_UPLOADS_ROOT="/var/data"

# --- Ops ---
# LOG_LEVEL=INFO
# DOCKER_BUILD=1
# (set DOCKER_BUILD=1 only when building a Docker image that expects output: standalone)
# Optional WordPress HTTP tuning:
# WORDPRESS_HTTP_TIMEOUT_MS=45000
# WORDPRESS_HTTP_RETRIES=2
